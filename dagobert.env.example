# ============================================================
# Dagobert environment variables
# Copy to dagobert.env and fill in your values
# NEVER commit dagobert.env to git
# ============================================================

# SQLite database path (inside container volume)
DB_URL=data/dagobert.db?_journal_mode=WAL&_foreign_keys=on

# Disable HTTPS enforcement (we're behind a local/reverse proxy without TLS for now)
WEB_SECURE=false

# ---------- SSO (disabled by default — use local accounts) ----------
OIDC_ENABLED=false
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_CLIENT_URL=http://YOUR_VM_IP:8080
# OIDC_AUTO_PROVISION=false

# ---------- Optional threat intel APIs ----------
# VIRUSTOTAL_APIKEY=
# ABUSEIPDB_APIKEY=
# HYBRIDANALYSIS_APIKEY=

# ---------- Webhook secret (optional, for signed callbacks) ----------
# MODULE_WEBHOOK_SECRET=

# ---------- Worker pool ----------
DAGOBERT_WORKERS=2
