# ============================================================
# n8n environment variables
# Copy to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# ---------- n8n ----------
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Generate: openssl rand -hex 32
N8N_ENCRYPTION_KEY=CHANGE_ME_32_CHAR_HEX

# VM IP — використовується у webhook URLs
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=https
WEBHOOK_URL=https://YOUR_VM_IP:5678/

# Timezone
GENERIC_TIMEZONE=Europe/Kyiv
TZ=Europe/Kyiv

# ---------- Dagobert API key (додати пізніше) ----------
# DAGOBERT_API_KEY=dgb_CHANGE_ME
