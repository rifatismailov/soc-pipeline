# ============================================================
# n8n environment variables
# Copy to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# ---------- n8n ----------
# Basic auth for n8n web UI
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# n8n encryption key (generate once: openssl rand -hex 32)
N8N_ENCRYPTION_KEY=CHANGE_ME_32_CHAR_HEX

# Public URL of n8n (used in webhook URLs shown in UI)
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://YOUR_VM_IP:5678/

# Timezone (affects workflow schedules)
GENERIC_TIMEZONE=Europe/Kyiv
TZ=Europe/Kyiv

# ---------- Dagobert API key ----------
# Set after first run: see README for how to generate
DAGOBERT_API_KEY=dgb_CHANGE_ME
